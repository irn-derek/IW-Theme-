        <div class="iw-menu__footer">
          <img src="{{ 'dagger-white.png' | asset_url }}" alt="" class="iw-menu__footer-dagger">
          <span class="iw-menu__footer-text">EARN THE DAGGER</span>
        </div>
      </div>

      {%- comment %} DAGGER CLUB pane {%- endcomment %}
      <div class="iw-menu__pane" data-kind="dagger" style="display:none;flex-direction:column">
        <div class="iw-menu__group">
          <a href="/pages/ranks" class="iw-menu__link-big">Join the Ranks</a>
          <a href="/pages/member-perks" class="iw-menu__link-big">Member Perks</a>
