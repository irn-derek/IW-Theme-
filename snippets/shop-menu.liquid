        <div class="iw-menu__group-head">EXPLORE</div>
        <div class="iw-menu__group">
          <a href="/pages/ranks" class="iw-menu__row">
            <span class="iw-menu__row-label">Ranks Loyalty Programme</span>
          </a>
          <a href="/pages/events" class="iw-menu__row">
            <span class="iw-menu__row-label">Events</span>
          </a>
          <a href="/pages/brand" class="iw-menu__row">
            <span class="iw-menu__row-label">Behind the Brand</span>
          </a>
          <a href="/pages/retail" class="iw-menu__row">
            <span class="iw-menu__row-label">Retail</span>
          </a>
        </div>

        <div class="iw-menu__footer">
          <img src="{{ 'dagger-white.png' | asset_url }}" alt="" class="iw-menu__footer-dagger">
          <span class="iw-menu__footer-text">EARN THE DAGGER</span>
        </div>
      </div>

      {%- comment %} BRAND pane {%- endcomment %}
      <div class="iw-menu__pane" data-kind="brand" style="display:none;flex-direction:column">
        <div class="iw-menu__group">
          <a href="/pages/about" class="iw-menu__link-big">About</a>
