{%- comment %} Shop Menu — slides in from left with tab switching {%- endcomment %}

<div id="iw-menu-scrim" class="iw-menu-scrim" aria-hidden="true"></div>

<aside
  id="iw-menu-panel"
  class="iw-menu-panel"
  aria-label="Navigation menu"
  aria-modal="true"
  role="dialog"
>

  {%- comment %} ===== LIST SIDE ===== {%- endcomment %}
  <div class="iw-menu__list">
    <div class="iw-menu__list-head">
      <div class="iw-menu__tabs">
        <a href="#" class="iw-menu__tab active" data-kind="shop">SHOP</a>
        <a href="#" class="iw-menu__tab" data-kind="brand">BRAND</a>
        <a href="#" class="iw-menu__tab" data-kind="dagger">DAGGER CLUB</a>
      </div>
      <button class="iw-menu__close" aria-label="Close menu">
        <svg class="iw-menu__close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="iw-menu__list-body">

      {%- comment %} SHOP pane {%- endcomment %}
      <div class="iw-menu__pane" data-kind="shop" style="display:flex;flex-direction:column">
        <div class="iw-menu__group">
          <a href="/collections/new-arrivals" class="iw-menu__link-big">New Arrivals</a>
