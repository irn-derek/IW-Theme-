<div style="padding-top:calc(var(--iw-ann-height) + var(--iw-nav-height)); min-height:100vh;">

  {%- if article.image -%}
    <div style="position:relative;height:70vh;overflow:hidden;">
      <img src="{{ article.image | image_url: width:2400 }}" alt="{{ article.image.alt | escape }}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(100%) contrast(1.05) brightness(0.8);">
      <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.8) 0%,rgba(0,0,0,0.1) 60%);"></div>
      <div style="position:absolute;bottom:48px;left:32px;right:32px;max-width:var(--iw-container-max);margin:0 auto;">
        <div style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;color:var(--iw-gray);text-transform:uppercase;margin-bottom:16px;">
          {{ article.published_at | date: '%B %d, %Y' | upcase }}
          {%- if article.tags.size > 0 %} · {{ article.tags | join: ' · ' | upcase }}{%- endif %}
        </div>
        <h1 style="font-family:var(--iw-font-display);font-size:clamp(36px,5vw,72px);font-weight:500;text-transform:uppercase;letter-spacing:-1px;line-height:1;margin:0;">{{ article.title }}</h1>
      </div>
    </div>
  {%- else -%}
    <div style="max-width:var(--iw-container-max);margin:0 auto;padding:72px 32px 48px;border-bottom:1px solid #1a1a1a;">
      <a href="{{ blog.url }}" style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;color:var(--iw-gray);text-transform:uppercase;display:inline-block;margin-bottom:24px;">← {{ blog.title | upcase }}</a>
      <div style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;color:var(--iw-gray);text-transform:uppercase;margin-bottom:16px;">{{ article.published_at | date: '%B %d, %Y' | upcase }}</div>
      <h1 style="font-family:var(--iw-font-display);font-size:clamp(36px,5vw,72px);font-weight:500;text-transform:uppercase;letter-spacing:-1px;line-height:1;margin:0;">{{ article.title }}</h1>
    </div>
  {%- endif -%}

  <div style="max-width:760px;margin:0 auto;padding:64px 32px 96px;">
    {%- if article.image -%}
      <a href="{{ blog.url }}" style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;color:var(--iw-gray);text-transform:uppercase;display:inline-block;margin-bottom:40px;">← {{ blog.title | upcase }}</a>
    {%- endif -%}

    <div class="iw-article-body" style="font-family:var(--iw-font-body);font-size:17px;line-height:1.75;color:#e0e0e0;">
      {{ article.content }}
    </div>

    {%- if article.tags.size > 0 -%}
      <div style="margin-top:64px;padding-top:32px;border-top:1px solid #1a1a1a;display:flex;gap:8px;flex-wrap:wrap;">
        {%- for tag in article.tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" style="font-family:var(--iw-font-mono);font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:var(--iw-gray);border:1px solid #333;padding:6px 12px;transition:border-color 200ms;">{{ tag | upcase }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div style="margin-top:64px;padding-top:32px;border-top:1px solid #1a1a1a;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;">
      {%- if blog.previous_article -%}
        <a href="{{ blog.previous_article }}" style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;text-transform:uppercase;color:#fff;text-decoration:none;border-bottom:1px solid #fff;padding-bottom:2px;">← PREV</a>
      {%- else -%}<span></span>{%- endif -%}
      {%- if blog.next_article -%}
        <a href="{{ blog.next_article }}" style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;text-transform:uppercase;color:#fff;text-decoration:none;border-bottom:1px solid #fff;padding-bottom:2px;">NEXT →</a>
      {%- endif -%}
    </div>
  </div>

</div>

<style>
.iw-article-body h2,.iw-article-body h3 { font-family:var(--iw-font-display);text-transform:uppercase;font-weight:500;letter-spacing:-0.3px;margin:48px 0 16px; }
.iw-article-body h2 { font-size:28px; }
.iw-article-body h3 { font-size:20px; }
.iw-article-body p { margin-bottom:24px; }
.iw-article-body a { color:#fff;border-bottom:1px solid #555; }
.iw-article-body a:hover { border-color:#fff;opacity:1; }
.iw-article-body img { width:100%;height:auto;display:block;margin:40px 0;filter:grayscale(100%) contrast(1.05); }
.iw-article-body blockquote { border-left:2px solid #fff;padding:0 0 0 24px;margin:40px 0;font-family:var(--iw-font-display);font-size:20px;font-weight:500;text-transform:uppercase;letter-spacing:-0.3px;line-height:1.3;color:#fff; }
.iw-article-body ul,.iw-article-body ol { padding-left:0;margin-bottom:24px; }
.iw-article-body li { font-family:var(--iw-font-mono);font-size:13px;letter-spacing:1.2px;text-transform:uppercase;color:#999;padding:8px 0;border-bottom:1px solid #111;list-style:none; }
.iw-article-body li::before { content:"— ";color:#555; }
</style>
