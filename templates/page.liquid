<div style="padding-top: calc(var(--iw-ann-height) + var(--iw-nav-height)); max-width: 860px; margin: 0 auto; padding-left: 32px; padding-right: 32px; padding-bottom: 96px; min-height: 100vh;">
  <div style="padding: 72px 0 48px; border-bottom: 1px solid #1a1a1a; margin-bottom: 48px;">
    <h1 style="font-family: var(--iw-font-display); font-size: clamp(36px, 5vw, 72px); font-weight: 500; text-transform: uppercase; letter-spacing: -1px; line-height: 1; margin: 0;">{{ page.title }}</h1>
  </div>
  <div style="font-family: var(--iw-font-body); font-size: 16px; line-height: 1.7; color: #ccc; max-width: 680px;">
    {{ page.content }}
  </div>
</div>
