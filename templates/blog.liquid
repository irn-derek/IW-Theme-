{%- paginate blog.articles by 12 -%}

<div style="padding-top:calc(var(--iw-ann-height) + var(--iw-nav-height)); max-width:var(--iw-container-max); margin:0 auto; padding-left:32px; padding-right:32px; padding-bottom:96px; min-height:100vh;">

  <div style="padding:72px 0 48px; border-bottom:1px solid #1a1a1a; margin-bottom:64px;">
    <div style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;color:var(--iw-gray);text-transform:uppercase;margin-bottom:12px;">THE JOURNAL</div>
    <h1 style="font-family:var(--iw-font-display);font-size:clamp(48px,6vw,96px);font-weight:500;text-transform:uppercase;letter-spacing:-1px;line-height:1;margin:0;">{{ blog.title | upcase }}</h1>
  </div>

  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:2px;">
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}" style="display:block;position:relative;text-decoration:none;color:#fff;border:1px solid #1a1a1a;overflow:hidden;">
        {%- if article.image -%}
          <div style="aspect-ratio:4/3;overflow:hidden;position:relative;">
            <img src="{{ article.image | image_url: width:800 }}" alt="{{ article.image.alt | escape }}" style="width:100%;height:100%;object-fit:cover;filter:grayscale(100%) contrast(1.05);transition:transform 600ms;">
            <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.6) 0%,rgba(0,0,0,0) 60%);"></div>
          </div>
        {%- else -%}
          <div style="aspect-ratio:4/3;background:#0a0a0a;"></div>
        {%- endif -%}
        <div style="padding:24px;">
          <div style="font-family:var(--iw-font-mono);font-size:10px;letter-spacing:1.4px;color:var(--iw-gray);text-transform:uppercase;margin-bottom:10px;">
            {{ article.published_at | date: '%b %d, %Y' | upcase }}
            {%- if article.tags.size > 0 %} · {{ article.tags.first | upcase }}{%- endif %}
          </div>
          <h2 style="font-family:var(--iw-font-display);font-size:22px;font-weight:500;text-transform:uppercase;letter-spacing:-0.3px;line-height:1.1;margin:0 0 12px;">{{ article.title }}</h2>
          {%- if article.excerpt -%}
            <p style="font-family:var(--iw-font-body);font-size:14px;color:#999;line-height:1.5;margin:0;">{{ article.excerpt | strip_html | truncate: 100 }}</p>
          {%- endif -%}
          <div style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;text-transform:uppercase;color:#fff;border-bottom:1px solid #fff;padding-bottom:2px;display:inline-block;margin-top:20px;">READ →</div>
        </div>
      </a>
    {%- endfor -%}
  </div>

  {%- if paginate.pages > 1 -%}
    <div style="display:flex;align-items:center;justify-content:center;gap:32px;margin-top:72px;">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="iw-btn">← PREV</a>{%- endif -%}
      <span style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;color:var(--iw-gray);">{{ paginate.current_page }} / {{ paginate.pages }}</span>
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="iw-btn">NEXT →</a>{%- endif -%}
    </div>
  {%- endif -%}

</div>

{%- endpaginate -%}
