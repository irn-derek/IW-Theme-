<div style="padding-top:calc(var(--iw-ann-height) + var(--iw-nav-height));min-height:100vh;display:flex;align-items:center;justify-content:center;padding-bottom:96px;">
  <div style="width:100%;max-width:440px;padding:0 32px;">

    <div style="text-align:center;margin-bottom:48px;">
      <img src="{{ 'dagger-white.png' | asset_url }}" alt="" style="height:56px;margin:0 auto 24px;">
      <h1 style="font-family:var(--iw-font-display);font-size:36px;font-weight:500;text-transform:uppercase;letter-spacing:-0.5px;margin:0 0 8px;">JOIN THE RANKS</h1>
      <p style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;color:var(--iw-gray);text-transform:uppercase;">Create your account</p>
    </div>

    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <p style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;color:#ff4444;text-transform:uppercase;margin-bottom:20px;text-align:center;">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:24px;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <input type="text" name="customer[first_name]" placeholder="FIRST NAME" autocomplete="given-name"
            style="background:#000;border:1px solid #333;color:#fff;padding:14px 16px;font-family:var(--iw-font-mono);font-size:12px;letter-spacing:1.4px;text-transform:uppercase;outline:none;transition:border-color 200ms;"
            onfocus="this.style.borderColor='#fff'" onblur="this.style.borderColor='#333'">
          <input type="text" name="customer[last_name]" placeholder="LAST NAME" autocomplete="family-name"
            style="background:#000;border:1px solid #333;color:#fff;padding:14px 16px;font-family:var(--iw-font-mono);font-size:12px;letter-spacing:1.4px;text-transform:uppercase;outline:none;transition:border-color 200ms;"
            onfocus="this.style.borderColor='#fff'" onblur="this.style.borderColor='#333'">
        </div>
        <input type="email" name="customer[email]" placeholder="EMAIL" autocomplete="email" required
          style="background:#000;border:1px solid #333;color:#fff;padding:14px 16px;font-family:var(--iw-font-mono);font-size:12px;letter-spacing:1.4px;text-transform:uppercase;outline:none;transition:border-color 200ms;"
          onfocus="this.style.borderColor='#fff'" onblur="this.style.borderColor='#333'">
        <input type="password" name="customer[password]" placeholder="PASSWORD" autocomplete="new-password" required
          style="background:#000;border:1px solid #333;color:#fff;padding:14px 16px;font-family:var(--iw-font-mono);font-size:12px;letter-spacing:1.4px;text-transform:uppercase;outline:none;transition:border-color 200ms;"
          onfocus="this.style.borderColor='#fff'" onblur="this.style.borderColor='#333'">
      </div>

      <button type="submit" class="iw-btn-filled" style="width:100%;height:52px;font-size:13px;margin-bottom:12px;">CREATE ACCOUNT</button>
      <div style="text-align:center;">
        <a href="/account/login" style="font-family:var(--iw-font-mono);font-size:10px;letter-spacing:1.4px;color:var(--iw-gray);text-transform:uppercase;border-bottom:1px solid #333;padding-bottom:2px;">ALREADY HAVE AN ACCOUNT?</a>
      </div>
    {%- endform -%}

  </div>
</div>
