<div style="padding-top:calc(var(--iw-ann-height) + var(--iw-nav-height));min-height:100vh;display:flex;align-items:center;justify-content:center;padding-bottom:96px;">
  <div style="width:100%;max-width:440px;padding:0 32px;">
    <div style="text-align:center;margin-bottom:48px;">
      <img src="{{ 'dagger-white.png' | asset_url }}" alt="" style="height:56px;margin:0 auto 24px;">
      <h1 style="font-family:var(--iw-font-display);font-size:36px;font-weight:500;text-transform:uppercase;letter-spacing:-0.5px;margin:0 0 8px;">ACTIVATE ACCOUNT</h1>
      <p style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;color:var(--iw-gray);text-transform:uppercase;">Set your password to get started</p>
    </div>
    {%- form 'activate_customer_password' -%}
      <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:24px;">
        <input type="password" name="customer[password]" placeholder="PASSWORD" required
          style="background:#000;border:1px solid #333;color:#fff;padding:14px 16px;font-family:var(--iw-font-mono);font-size:12px;letter-spacing:1.4px;text-transform:uppercase;outline:none;">
        <input type="password" name="customer[password_confirmation]" placeholder="CONFIRM PASSWORD" required
          style="background:#000;border:1px solid #333;color:#fff;padding:14px 16px;font-family:var(--iw-font-mono);font-size:12px;letter-spacing:1.4px;text-transform:uppercase;outline:none;">
      </div>
      <button type="submit" class="iw-btn-filled" style="width:100%;height:52px;font-size:13px;">ACTIVATE ACCOUNT</button>
    {%- endform -%}
  </div>
</div>
