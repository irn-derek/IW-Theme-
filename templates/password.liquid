<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} — Coming Soon</title>
  <link rel="icon" type="image/png" href="{{ 'dagger-white.png' | asset_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;500&family=Space+Mono:wght@400&display=swap" rel="stylesheet">
  {{ content_for_header }}
  {{ 'ironwilled.css' | asset_url | stylesheet_tag }}
</head>
<body style="background:#000;color:#fff;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:32px;">

  <img src="{{ 'dagger-3d.gif' | asset_url }}" alt="{{ shop.name }}" style="height:80px;margin-bottom:48px;">

  <div style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.8px;text-transform:uppercase;color:var(--iw-gray);margin-bottom:16px;">THE FORGE IS OPEN</div>
  <h1 style="font-family:var(--iw-font-display);font-size:clamp(48px,8vw,120px);font-weight:500;text-transform:uppercase;letter-spacing:-1px;line-height:0.95;margin:0 0 48px;">COMING<br>SOON.</h1>

  {%- if shop.password_message -%}
    <p style="font-family:var(--iw-font-body);font-size:16px;color:var(--iw-gray);max-width:480px;margin:0 0 48px;line-height:1.6;">{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <p style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;color:#ff4444;text-transform:uppercase;margin-bottom:16px;">WRONG PASSWORD</p>
    {%- endif -%}
    <div style="display:flex;align-items:center;border-bottom:1px solid #fff;max-width:400px;width:100%;margin:0 auto;">
      <input
        type="password"
        name="password"
        placeholder="ENTER PASSWORD"
        style="flex:1;background:transparent;border:0;outline:none;color:#fff;padding:16px 0;font-family:var(--iw-font-mono);font-size:13px;letter-spacing:1.4px;text-transform:uppercase;"
        required
      >
      <button type="submit" style="background:transparent;border:0;color:#fff;cursor:pointer;font-family:var(--iw-font-mono);font-size:16px;padding:0 8px;">→</button>
    </div>
  {%- endform -%}

  <p style="font-family:var(--iw-font-mono);font-size:10px;letter-spacing:1.4px;color:#666;text-transform:uppercase;margin-top:64px;">© {{ 'now' | date:'%Y' }} IRONWILLED · FORGED IN DETROIT</p>

</body>
</html>
