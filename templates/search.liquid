<div style="padding-top:calc(var(--iw-ann-height) + var(--iw-nav-height)); max-width:var(--iw-container-max); margin:0 auto; padding-left:32px; padding-right:32px; padding-bottom:96px; min-height:100vh;">

  <div style="padding:72px 0 48px; border-bottom:1px solid #1a1a1a; margin-bottom:48px;">
    <div style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;color:var(--iw-gray);text-transform:uppercase;margin-bottom:16px;">SEARCH</div>
    <form action="/search" method="get" style="display:flex;align-items:center;border-bottom:1px solid #fff;max-width:640px;gap:16px;">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="SEARCH THE ARCHIVE..."
        style="flex:1;background:transparent;border:0;outline:none;color:#fff;padding:16px 0;font-family:var(--iw-font-display);font-size:clamp(24px,3vw,48px);font-weight:500;text-transform:uppercase;letter-spacing:-0.5px;"
      >
      <button type="submit" style="background:transparent;border:0;color:#fff;cursor:pointer;font-family:var(--iw-font-mono);font-size:14px;letter-spacing:1.4px;padding:0;flex-shrink:0;">→</button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <div style="text-align:center;padding:80px 0;">
        <img src="{{ 'dagger-white.png' | asset_url }}" alt="" style="height:64px;opacity:0.3;margin:0 auto 32px;">
        <h2 style="font-family:var(--iw-font-display);font-size:36px;font-weight:500;text-transform:uppercase;margin:0 0 12px;">NO RESULTS.</h2>
        <p style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;color:var(--iw-gray);text-transform:uppercase;">Try a different search term.</p>
      </div>
    {%- else -%}
      <div style="font-family:var(--iw-font-mono);font-size:11px;letter-spacing:1.4px;color:var(--iw-gray);text-transform:uppercase;margin-bottom:36px;">
        {{ search.results_count }} RESULTS FOR "{{ search.terms | upcase }}"
      </div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {%- render 'product-card', product: item, index: forloop.index -%}
          {%- else -%}
            <a href="{{ item.url }}" style="display:block;padding:24px;border:1px solid #1a1a1a;text-decoration:none;color:#fff;">
              <div style="font-family:var(--iw-font-mono);font-size:10px;letter-spacing:1.4px;color:var(--iw-gray);text-transform:uppercase;margin-bottom:8px;">{{ item.object_type | upcase }}</div>
              <div style="font-family:var(--iw-font-body);font-size:15px;">{{ item.title }}</div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}

</div>
